2. Convert Student Object to Map and Map to Student
Code
class Student {
  String name;
  int rollNo;
  String course;

  Student(this.name, this.rollNo, this.course);

  Map<String, dynamic> toMap() {
    return {
      'name': name,
      'rollNo': rollNo,
      'course': course
    };
  }

  factory Student.fromMap(Map<String, dynamic> map) {
    return Student(map['name'], map['rollNo'], map['course']);
  }
}

void main() {
  Student s1 = Student('Abdul', 101, 'BCA');

  Map data = s1.toMap();
  print(data);

  Student s2 = Student.fromMap(data);
  print('${s2.name}, ${s2.rollNo}, ${s2.course}');
}
Output
{name: Abdul, rollNo: 101, course: BCA}
Abdul, 101, BCA
