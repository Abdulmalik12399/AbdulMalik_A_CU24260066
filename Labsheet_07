15. Student Model Class
class Student {
  int? id;
  String name, roll, course;

  Student(this.name, this.roll, this.course, {this.id});

  Map<String, dynamic> toMap() => {
    'id': id,
    'name': name,
    'roll': roll,
    'course': course,
  };

  factory Student.fromMap(Map<String, dynamic> map) {
    return Student(
      map['name'],
      map['roll'],
      map['course'],
      id: map['id'],
    );
  }
}


Usage:
await db.insert('students',
    Student('Rahul', '101', 'BCA').toMap());

var rows = await db.query('students');
var students = rows.map((e) => Student.fromMap(e)).toList();


16. DatabaseHelper Class
class DatabaseHelper {
  static Future<Database> openDB() async {
    return openDatabase(
      'student.db',
      version: 1,
      onCreate: (db, version) async {
        await db.execute(
          'CREATE TABLE students(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, roll TEXT, course TEXT)',
        );
      },
    );
  }

  static Future<int> insert(Map<String, dynamic> data) async {
    final db = await openDB();
    return db.insert('students', data);
  }

  static Future<List<Map<String, dynamic>>> read() async {
    final db = await openDB();
    return db.query('students');
  }

  static Future<int> update(int id, Map<String, dynamic> data) async {
    final db = await openDB();
    return db.update('students', data,
        where: 'id = ?', whereArgs: [id]);
  }

  static Future<int> delete(int id) async {
    final db = await openDB();
    return db.delete('students',
        where: 'id = ?', whereArgs: [id]);
  }
}


