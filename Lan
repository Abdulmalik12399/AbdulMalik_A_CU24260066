13. Form Validation Before Insert
final formKey = GlobalKey<FormState>();

Form(
  key: formKey,
  child: Column(
    children: [
      TextFormField(
        validator: (v) =>
            v == null || v.isEmpty ? 'Enter name' : null,
      ),
      TextFormField(
        validator: (v) =>
            v == null || !v.contains('@') ? 'Invalid email' : null,
      ),
      TextFormField(
        obscureText: true,
        validator: (v) =>
            v == null || v.length < 6 ? 'Minimum 6 characters' : null,
      ),
      ElevatedButton(
        onPressed: () {
          if (formKey.currentState!.validate()) {
            print('Insert record into SQLite');
          }
        },
        child: Text('Register'),
      ),
    ],
  ),
);


