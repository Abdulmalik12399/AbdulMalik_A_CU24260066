3. var, final and const
void main() {
  var name = "Abdul";
  final age = 21;
  const pi = 3.14;

  print(name);
  print(age);
  print(pi);
}

Output:

Abdul
21
3.14
4. Sum, Difference, Product and Quotient
void main() {
  int a = 10, b = 5;

  print("Sum: ${a + b}");
  print("Difference: ${a - b}");
  print("Product: ${a * b}");
  print("Quotient: ${a / b}");
}

Output:

Sum: 15
Difference: 5
Product: 50
Quotient: 2.0
