    print("Not a Leap Year");
}

Output:

Leap Year
14. Calculate Grade
void main() {
  int marks = 85;

  if (marks >= 90)
    print("Grade A+");
  else if (marks >= 80)
    print("Grade A");
  else if (marks >= 70)
    print("Grade B");
  else if (marks >= 60)
    print("Grade C");
  else
    print("Grade F");
}

Output:

Grade A
