10. API Error Handling with Retry Button
Future<String> fetchData() async {
  var r = await http.get(Uri.parse(
      'https://jsonplaceholder.typicode.com/posts/1'));
  if (r.statusCode == 200) return r.body;
  throw Exception('Failed to load data');
}

// Inside StatefulWidget:
Future<String>? future;

@override
void initState() {
  super.initState();
  future = fetchData();
}

// In build():
FutureBuilder<String>(
  future: future,
  builder: (context, s) {
    if (s.hasError) {
      return Column(mainAxisSize: MainAxisSize.min, children: [
        Text('Error: ${s.error}'),
        ElevatedButton(
          onPressed: () => setState(() => future = fetchData()),
          child: Text('Retry'),
        ),
      ]);
    }
    if (!s.hasData) return CircularProgressIndicator();
    return Text(s.data!);
  },
);


