1. Parse JSON Array into Student Objects
class Student {
  String name;
  int age;

  Student(this.name, this.age);

  factory Student.fromJson(Map<String, dynamic> json) =>
      Student(json['name'], json['age']);
}

void main() {
  String data = '[{"name":"Rahul","age":20}]';
  List list = jsonDecode(data);
  List<Student> students =
      list.map((e) => Student.fromJson(e)).toList();
  print(students[0].name);
}


